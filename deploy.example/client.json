{
  "log": {
    "level": "info",
    "timestamp": true
  },

  "inbounds": [
    {
      // 入口全部用 sing-box 自带的：mixed 同时支持 SOCKS5 与 HTTP。
      // 想全局代理就把这里换成 "tun"，想透明代理换成 "tproxy" / "redirect"，
      // flowtls 侧不需要改任何配置。
      "type": "mixed",
      "tag": "mixed-in",
      "listen": "127.0.0.1",
      "listen_port": 1080,
      "users": [
        { "username": "admin", "password": "CHANGE_ME_LOCAL_PASSWORD" }
      ]
    }
  ],

  "outbounds": [
    {
      "type": "flowtls",
      "tag": "flowtls-out",

      "server": "203.0.113.10",
      "server_port": 8443,

      // 必须与服务端一致
      "password": "CHANGE_ME_STRONG_PASSWORD",

      // 固定源端口：客户端 iptables 靠它精确拦截内核 RST。
      "source_port": 44300,

      // 与服务端 ip_id_mark 一致（0xF107 = 61703）
      "ip_id_mark": 61703,

      // 只影响伪 ClientHello 的外观，不参与任何校验
      "sni": "your.domain",

      // 标准三次握手默认开启。**不要关**：
      // 严格 NAT / 状态防火墙只放行握手完成的流量，关掉会直接被丢。
      // 仅在客户端有公网 IP 且链路无状态检查时可设为 true 省一个 RTT。
      "disable_handshake": false,

      // 客户端规则落地方式，取值同服务端。
      // 客户端规则的作用：屏蔽内核对伪连接回的 RST。
      // Session 走 raw socket，内核里没有对应 socket，收到 SYN-ACK 就回 RST，
      // 而 RST 会让中间设备立即拆掉 NAT 映射。
      "iptables_mode": "print",

      // QUIC 拥塞窗口上限（字节），默认 8MB（可省略）。
      //
      // 对应老 Rust 版的 net.max_cwnd。**必须与服务端填同一个值**，
      // 否则两边自适应上限不同步，容易单侧过早降速。
      // 小带宽跨境链路（20~50Mbps）建议 1048576（1MB）。
      "max_cwnd": 8388608
    },

    { "type": "direct", "tag": "direct" }
  ],

  "route": {
    "final": "flowtls-out",

    // 私有网段直连，避免把内网流量塞进隧道
    "rules": [
      { "ip_is_private": true, "outbound": "direct" }
    ]
  }
}
