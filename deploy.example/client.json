{
  "log": {
    "level": "info",
    "timestamp": true
  },

  "inbounds": [
    {
      // 入口全部用 sing-box 自带的：mixed 同时支持 SOCKS5 与 HTTP。
      // 想全局代理就把这里换成 "tun"，想透明代理换成 "tproxy" / "redirect"，
      // flowtls 侧不需要改任何配置。
      "type": "mixed",
      "tag": "mixed-in",
      // **必须 "0.0.0.0"**：本机客户端要能被局域网/容器/其它进程访问。
      // 写成 "127.0.0.1" 时，只有本机回环能连，
      // 局域网设备、Docker 容器、WSL、另一台虚机全部连不上——
      // 而现象只是「连接被拒」，不报任何配置错误。
      //
      // 代价是入口对整个局域网可达，所以 users 里的口令必须改掉
      // （它是与外层 AEAD 无关的本地入口凭据）；不需要对外时请用防火墙限网段。
      "listen": "0.0.0.0",
      "listen_port": 1080,
      "users": [
        { "username": "admin", "password": "CHANGE_ME_LOCAL_PASSWORD" }
      ]
    }
  ],

  "outbounds": [
    {
      "type": "flowtls",
      "tag": "flowtls-out",

      "server": "203.0.113.10",
      "server_port": 8443,

      // 必须与服务端一致
      "password": "CHANGE_ME_STRONG_PASSWORD",

      // **不要填 source_port**：留空即由核心自动分配一个当前未在用的端口。
      //
      // 为什么不再固定：一条 FlowTLS 隧道就是一个固定四元组，服务端靠它
      // 定位会话。固定源端口等于「一条隧道占一个端口」，而两台机器（或
      // 同一台机器的多个节点）经同一个 NAT 去同一台服务端时，源端口相同
      // 就会四元组撞车——服务端只认一个会话，新 SYN 把旧会话踢掉。
      //
      // 旧版（≤ rev.6）必须固定，是因为防火墙规则按源端口匹配内核回的
      // RST。rev.7 起规则改成按服务端地址匹配，这个限制已消失。

      // **不要填 ip_id_mark**：它由 password 经 HKDF-SHA256 派生，
      // 两端各自算一次就得到同一个值，不需要任何手工同步。
      //
      // 为什么可以派生：password 本来就两端共享、且每个部署各不相同，
      // 正好满足 ip_id_mark 的两个硬要求——两端一致、部署间不同。
      // 多用户部署时服务端为每个用户各派生一个，全部纳入识别范围
      // （内核层判断「是不是我们的包」时还没解密，不知道对端是谁）。
      //
      // **改 password 会同时换掉 mark**，所以两端要一起改。

      // 只影响伪 ClientHello 的外观，不参与任何校验
      "sni": "your.domain",

      // 标准三次握手，取值只有两个（与 Rust 完全一致）：
      //   symbolic — 默认。SYN → SYN-ACK → ACK，之后才发数据
      //   none     — 跳过握手直接发数据
      //
      // **不要设成 none**：严格 NAT / 状态防火墙只放行握手完成的流量，
      // 关掉会直接被丢。仅在客户端有公网 IP 且链路无状态检查时可省一个 RTT。
      "handshake": "symbolic",

      // **不需要配防火墙模式**：那两条规则（notrack + 拦内核回的 RST）
      // 由核心在第一个包发出前自动写入，没有开关。
      //
      // 它们不是可选优化：少了 notrack，fw4 会把伪包判成 ct invalid 丢掉
      // （现象是 sendto 返回 EPERM，看着像权限问题）；少了 RST 抑制，
      // 第一个 SYN-ACK 就把 NAT 映射拆掉。

      // QUIC 拥塞窗口上限（字节），默认 8MB（可省略）。
      //
      // 对应老 Rust 版的 net.max_cwnd。**必须与服务端填同一个值**，
      // 否则两边自适应上限不同步，容易单侧过早降速。
      // 小带宽跨境链路（20~50Mbps）建议 1048576（1MB）。
      "max_cwnd": 8388608
    },

    { "type": "direct", "tag": "direct" }
  ],

  "route": {
    "final": "flowtls-out",

    // 私有网段直连，避免把内网流量塞进隧道
    "rules": [
      { "ip_is_private": true, "outbound": "direct" }
    ]
  }
}
