{
  "log": {
    "level": "info",
    "timestamp": true,
    "output": "/var/log/flowtls-server.log"
  },

  "inbounds": [
    {
      "type": "flowtls",
      "tag": "flowtls-in",

      // flowtls 不 bind 内核端口：这两个字段只用于计算会话四元组
      // 和生成 iptables 规则。同端口的真证书网站要另起进程。
      "listen": "0.0.0.0",
      "listen_port": 8443,

      // 代理密码：外层 AEAD 的密钥来源（HKDF-SHA256）。请换成强密码。
      // 客户端必须完全一致。
      "password": "CHANGE_ME_STRONG_PASSWORD",

      // 多用户（可选）。结构与 sing-box 的 hysteria2 / anytls 一致：
      //   - name 只用于日志，可留空；
      //   - password 才是凭证，同时是 AEAD 密钥来源。
      // 线上不会传 name，也不会传 password 本身，只传 password 派生出的
      // 16 字节不透明 authID，服务端用它查表选密钥（O(1)，不逐个试解）。
      // 两个用户用同一个 password 会让 authID 冲突、后者覆盖前者。
      "users": [
        // { "name": "alice", "password": "CHANGE_ME_ALICE_STRONG_PASSWORD" },
        // { "name": "bob",   "password": "CHANGE_ME_BOB_STRONG_PASSWORD" }
      ],

      // 云主机在 NAT 后面时路由探测只能拿到内网地址（如 10.0.0.10），
      // 必须显式填**内网地址**，让网关做 1:1 SNAT。
      // 填公网地址会被网关反欺骗静默丢弃（Oracle Cloud 已实测）。
      // 不在 NAT 后面时留空即可，程序会自己探测。
      "local_ip": "10.0.0.10",

      // 伪包识别标记：IP ID 高字节。每个部署应不同。
      // 0xF107 = 61703。客户端必须填同一个值。
      "ip_id_mark": 61703,

      // raw 表规则落地方式，只有两个合法值（与 Rust 完全一致）：
      //   none  — 不生成也不执行，由部署方自己维护规则（默认）
      //   auto  — 启动时幂等写入 iptables
      //
      // 规则**写后不清理**：重启期间规则必须继续生效，否则内核会回 RST
      // 打断重建中的隧道。卸载命令打印在启动日志里。
      "iptables_mode": "auto",

      // 伪 ClientHello 的外观值，只影响服务端回应的 ServerHello，
      // 不参与任何校验。留空取默认 symbolic。
      "handshake": "symbolic",

      // UDP 走 QUIC DATAGRAM，不重传、不分片：队列满或超 MTU 即丢
      // （对齐 hysteria2 语义）。单包上限约 1200 字节，更大的 UDP 报文直接丢弃。
      "udp_enabled": true,
      // 每条连接上同时存在的 UDP 会话上限（默认 256）。
      // 每个会话占一个出站 UDP socket，而整机临时端口只有约 28k 个。
      "udp_max_sessions": 256,
      // UDP 会话空闲回收（秒，默认 120）。这与 fake-TCP 会话的空闲回收
      // 是两件事：前者可能只查一次 DNS，后者用户在线就一直有流量。
      "udp_session_timeout": 120,

      // QUIC 拥塞窗口上限（字节），默认 8MB（可省略）。
      //
      // 对应老 Rust 版的 net.max_cwnd，默认值与它完全一致：
      // 与 hysteria2 默认流窗口（8MB）对齐，按 1000Mbps × 70ms 的 BDP 留足余量。
      // 小带宽跨境链路（实际 20~50Mbps）建议调到 1048576（1MB），否则丢包会明显变多。
      //
      // **客户端与服务端必须填同一个值**，否则两边自适应上限不同步，
      // 容易出现单侧过早降速。
      "max_cwnd": 8388608,

      // 同端口真证书网站（应对主动端口探测）。
      //
      // 不配时 inbound 只做隧道，端口由其它进程（nginx/caddy）负责。
      // 配了就会**真 bind 内核 TCP 端口**：流控靠上面那条 raw 表规则——
      // 带标记的伪造包被 DROP，剩下的包才落到这个站点上。
      //
      // 行为完全照 Rust `site/mod.rs`：
      //   TLS 1.3，ALPN 只宣告 http/1.1
      //   GET/HEAD     → 静态文件 → 目录 index.html → 内置占位页
      //   /robots.txt  → Allow: /
      //   /favicon.ico → 204
      //   其它方法     → 405
      //
      // **没有 proxy_url / rewrite_host**：Rust 只 serve 静态目录。
      // 需要反向代理请在 sing-box 外用 nginx 做，再把 site_dir 指到 nginx 的页面。
      "masquerade": {
        // **真证书**，不能用自签：探测者能看到证书链。
        // fullchain 必须是「站点证书 + 中间证书」，
        // 私钥权限建议 600 且属主为运行 user。
        "certificate_path": "/etc/ssl/private/fullchain.pem",
        "key_path": "/etc/ssl/private/privkey.pem",

        // 静态文件根目录。留空返回内置占位页——
        // **占位页本身就是指纹，生产环境必须填真实内容**。
        "site_dir": "/var/www/lumen-edge"
      }
    }
  ],

  "outbounds": [
    { "type": "direct", "tag": "direct" }
  ]
}
